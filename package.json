{
  "name": "expiry-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-expiry-tracker \"node --test tests/rules.test.js\"",
    "test:functions": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=30 firebase emulators:exec --only auth,firestore,functions --project demo-expiry-tracker \"node --test tests/functions.test.js\""
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "bcryptjs": "^3.0.2",
    "cross-env": "^10.1.0",
    "firebase-tools": "^15.25.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
